# Root .env — read by docker-compose only. Copy to .env if you want to override defaults.
# The mock demo needs NONE of this; `pnpm dev` works with no .env and no Docker.

POSTGRES_USER=mygpt
POSTGRES_PASSWORD=mygpt
POSTGRES_DB=mygpt_dev

# Host ports are offset (5433 / 6380) so they don't collide with other local projects
# (fansibly / averroesng) that already bind 5432 / 6379.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6380
BACKEND_HOST_PORT=4000
