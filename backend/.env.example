PORT=4000
NODE_ENV=development
# Comma-separated. Leave unset in dev to allow any http://localhost:<port>
# CORS_ORIGIN=http://localhost:3000

# true  → in-memory MockStore seeded from src/data/fixtures (no Docker needed)
# false → PostgresStore (stub today — implement src/data/postgres before flipping)
USE_MOCK_DATA=true

# Attach the Socket.IO Redis adapter (pub/sub across backend instances). Falls back to
# in-memory if Redis is unreachable.
ENABLE_REDIS_ADAPTER=false

# Used once the real data layer / redis adapter are on. Ports match docker-compose host ports.
DATABASE_URL=postgresql://mygpt:mygpt@localhost:5433/mygpt_dev
REDIS_URL=redis://localhost:6380

# Tenant used when a request carries no x-tenant-id header (demo only — replaced by auth later)
DEFAULT_TENANT_ID=tnt_baycrest
