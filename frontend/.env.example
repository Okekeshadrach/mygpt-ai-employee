# The browser calls this Next.js server; /api and /socket.io are proxied to the backend.
# Where the Next.js server finds the backend (baked in at `next build`):
BACKEND_INTERNAL_URL=http://localhost:4000

# Optional: bypass the proxy and call the API directly from the browser
# NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
# NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
NEXT_PUBLIC_TENANT_ID=tnt_baycrest
